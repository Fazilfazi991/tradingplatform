[Unit]
Description=Verified Edge internal intelligence scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=verified-edge
Group=verified-edge
WorkingDirectory=/opt/verified-edge/current
EnvironmentFile=/etc/verified-edge/intelligence.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/verified-edge/current/.venv/bin/python scripts/verify_release_environment.py --profile intelligence-worker --stage production
ExecStart=/opt/verified-edge/current/.venv/bin/python scripts/run_intelligence_worker.py --state /var/lib/verified-edge/intelligence-operations.sqlite3 --output-root /var/lib/verified-edge/intelligence
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/verified-edge

[Install]
WantedBy=multi-user.target
