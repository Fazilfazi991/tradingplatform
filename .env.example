# Server-side only. Never prefix these with NEXT_PUBLIC_.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
DATABASE_URL=postgresql+psycopg://verified_edge:change-me@localhost:5432/verified_edge
VE_RAW_ROOT=data/raw
VE_QUARANTINE_ROOT=data/quarantine
VE_EXPORT_ROOT=data/exports
VE_LOG_LEVEL=INFO
CODEX_RESEARCH_OPERATOR_ENABLED=false
NEXT_PUBLIC_SITE_URL=

# Required to expose internal research/admin routes. Use long, unique values.
VERIFIED_EDGE_INTERNAL_USERNAME=
VERIFIED_EDGE_INTERNAL_PASSWORD=

# Optional provider activation. Missing alternative providers remain disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_RUNTIME_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GLM_API_KEY=
GLM_MODEL=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_MODEL=
MOONSHOT_API_KEY=
MOONSHOT_MODEL=

# Conservative internal semantic-analysis ceilings in USD.
LLM_DAILY_BUDGET_USD=
LLM_PER_TASK_BUDGET_USD=
LLM_HIGH_MATERIALITY_BUDGET_USD=
